# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Supabase (Project Settings → API). The URL and the publishable/anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server-only key for the admin panel. Never share it or put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for the contact details built into src/lib/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_TELEGRAM_USERNAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADDRESS=

# Who may sign in to /admin (comma separated). Required for the admin panel.
ADMIN_EMAILS=
